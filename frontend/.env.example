# Copy this file to .env.local and fill in the values after deploying the CDK stack.
# .env.local is gitignored — never commit it.
# These values are available as CloudFormation outputs after running: npm run deploy (in infra/)

# Cognito hosted UI base URL (output: CognitoDomain)
VITE_COGNITO_DOMAIN=https://<prefix>.auth.<region>.amazoncognito.com

# Cognito app client ID (output: UserPoolClientId)
VITE_COGNITO_CLIENT_ID=<client-id>

# OAuth2 redirect URI — must match what is configured in the Cognito app client
VITE_COGNITO_REDIRECT_URI=http://localhost:3000/callback

# API Gateway URL (output: ApiUrl)
VITE_API_URL=https://<api-id>.execute-api.<region>.amazonaws.com
