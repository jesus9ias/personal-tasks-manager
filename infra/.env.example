# Copy this file to .env and fill in your values.
# .env is gitignored — never commit it.

# Your root domain (must exist as a Route53 hosted zone in your AWS account)
DOMAIN_NAME=your-domain.com

# Subdomain for the app (final URL will be APP_SUBDOMAIN.DOMAIN_NAME)
APP_SUBDOMAIN=tasks

# Prefix for the Cognito hosted UI domain (must be globally unique across AWS)
COGNITO_DOMAIN_PREFIX=kanban-yourname

# AWS region to deploy into
AWS_REGION=us-east-1
